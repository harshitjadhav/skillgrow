
<!-- VIDEO FEEDBACK SECTION -->
<section id="feedback">
  <div class="wrap reveal">

    <h2 class="title">⭐ Real Video Feedback</h2>
    <p class="sub">
      Watch the experiences shared by our participants.
    </p>

    <div class="vfb-grid">
      <div class="vfb">
        <video controls playsinline preload="metadata">
          <source src="feedback.mp4" type="video/mp4">
          Your browser does not support video.
        </video>
        <p>Participant Experience</p>
      </div>
    </div>

  </div>
</section>

